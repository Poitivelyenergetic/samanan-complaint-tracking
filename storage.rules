rules_version = '2';

// Deploy with: firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {
    // Profile pictures — each staff member can only write their own, any
    // signed-in staff member can view any (shown in the TopBar/lists).
    match /avatars/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Complaint attachments (the complaint's own file, and one attached to
    // a reassignment reason) — any signed-in staff member can attach one,
    // since Firestore's own rules already gate who can actually save that
    // URL onto a complaint (complaints.update / complaints.reassign).
    match /complaints/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 15 * 1024 * 1024;
    }
  }
}
