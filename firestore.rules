rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
// (or paste into Firebase Console > Firestore Database > Rules)
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // `role` (admin/employee/user) is only a preset used by the client to
    // pre-fill `permissions` in the Employees form — every access check here
    // reads the individually-overridable `permissions` map instead, so an
    // admin can grant or withhold any of these independent of role.
    function myPermissions() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions;
    }

    function hasPermission(perm) {
      return isSignedIn() && myPermissions()[perm] == true;
    }

    // An account without viewAllComplaints may only read complaints
    // assigned to it or that it created itself — never the full list.
    function isOwnComplaint() {
      return resource.data.assignedTo == request.auth.uid
        || resource.data.createdBy == request.auth.uid;
    }

    // Anyone signed in may log a staff-side complaint, but only a
    // self-attributed one: they can't forge createdBy to impersonate someone
    // else, and can't submit through the "public" channel meant for
    // anonymous customers (that path is covered by isValidPublicComplaint).
    function isSelfCreatedComplaint() {
      let d = request.resource.data;
      return d.channel == "staff" && d.createdBy == request.auth.uid;
    }

    // A complaint submitted through the public intake form (no login) must
    // land as Open/unassigned with the fields the form actually collects —
    // this is what stops an anonymous client from writing an arbitrary
    // complaint (e.g. pre-closing it, assigning it to a staff member, or
    // impersonating a staff-logged entry).
    function isValidPublicComplaint() {
      let d = request.resource.data;
      return d.channel == "public"
        && d.status == "Open"
        && d.assignedTo == null
        && d.createdBy == null
        && d.description is string && d.description.size() > 0
        && d.category is string
        && d.complainantName is string && d.complainantName.size() > 0
        && d.customerOrderNumber is string && d.customerOrderNumber.size() > 0;
    }

    match /users/{userId} {
      // Any signed-in staff member can read the staff directory (needed for
      // the "assigned to" dropdown). Only accounts with manageEmployees can
      // create/edit/remove staff records.
      allow read: if isSignedIn();
      allow write: if hasPermission("manageEmployees");
    }

    // Four-level org-browsing hierarchy: Company > Administration (department)
    // > Position > Employee. Browsing just needs any signed-in staff account;
    // changing its shape is gated by manageCompanies (which can reshape
    // anything under a company), manageAdministrations, or managePositions —
    // each broader permission also grants the narrower ones below it.
    match /companies/{companyId} {
      allow read: if isSignedIn();
      allow write: if hasPermission("manageCompanies");
    }

    match /administrations/{administrationId} {
      allow read: if isSignedIn();
      allow write: if hasPermission("manageCompanies") || hasPermission("manageAdministrations");
    }

    match /positions/{positionId} {
      allow read: if isSignedIn();
      allow write: if hasPermission("manageCompanies")
        || hasPermission("manageAdministrations")
        || hasPermission("managePositions");
    }

    match /complaints/{complaintId} {
      allow read: if hasPermission("viewAllComplaints") || (isSignedIn() && isOwnComplaint());
      allow update, delete: if hasPermission("editAnyComplaint");
      allow create: if (isSignedIn() && isSelfCreatedComplaint()) || isValidPublicComplaint();
      // The public status-lookup page fetches one complaint by its exact
      // reference number (a capability token, not something to enumerate),
      // but only for complaints that were themselves submitted publicly —
      // a guessed ID pointing at a staff-logged complaint still 404s.
      allow get: if resource.data.channel == "public";
    }

    // Public staff-account requests. Deliberately holds no password — an
    // admin reviews it and creates the real Firebase Auth account (with a
    // password of their choosing) via the Employees "New Employee" flow.
    function isValidSignupRequest() {
      let d = request.resource.data;
      return d.status == "pending"
        && d.name is string && d.name.size() > 0
        && d.username is string && d.username.size() > 0
        && d.contact is string && d.contact.size() > 0
        && d.position is string
        && d.administration is string;
    }

    match /signupRequests/{requestId} {
      allow create: if isValidSignupRequest();
      allow read, update, delete: if hasPermission("manageEmployees");
    }
  }
}
