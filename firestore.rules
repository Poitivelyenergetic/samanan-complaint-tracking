rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
// (or paste into Firebase Console > Firestore Database > Rules)
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Roles are custom, admin-defined records — an employee can hold several
    // at once (roleIds), and their effective permission for any action is
    // the union (OR) across all assigned roles. Firestore rules can't loop
    // over an arbitrary-length roleIds array to fetch and OR together
    // multiple role docs at read time, so that union is computed
    // server-side (Admin SDK, in /api/employees and /api/roles) and
    // denormalized onto this doc's own `permissions` field whenever roleIds
    // change or a held role's permissions are edited. This is what every
    // check here actually reads.
    function myPermissions() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions;
    }

    function hasPermission(resource, action) {
      return isSignedIn() && myPermissions()[resource][action] == true;
    }

    // Complaints are logged internally by staff only — there is no public
    // complaint-intake or status-check flow. Anyone signed in with
    // complaints.create may log one, but only a self-attributed one: they
    // can't forge createdBy to impersonate someone else.
    function isSelfCreatedComplaint() {
      let d = request.resource.data;
      return d.channel == "staff" && d.createdBy == request.auth.uid;
    }

    // A staff member updating their own Account Settings — phone number and
    // profile picture only. Deliberately excludes name/number/jobTitle/org
    // placement/roleIds/permissions, which stay admin-managed via
    // /api/employees.
    function isSelfProfileWrite(userId) {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return request.auth.uid == userId && affected.hasOnly(["phone", "avatarUrl"]);
    }

    // Employee accounts (Firebase Auth UID-keyed). Any signed-in staff
    // member can read the directory (needed for "assigned to"/"boss"
    // dropdowns everywhere). Mutations normally go through /api/employees
    // (Admin SDK, so a new hire's own session isn't affected) — these rules
    // are the backstop against a direct client write bypassing that.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if hasPermission("employees", "create");
      allow update: if hasPermission("employees", "update") || isSelfProfileWrite(userId);
      allow delete: if hasPermission("employees", "delete");
    }

    // Org-browsing hierarchy: Company > Administration > Department.
    // Browsing just needs any signed-in staff account; changing its shape
    // is gated per-resource, per-action.
    match /companies/{companyId} {
      allow read: if isSignedIn();
      allow create: if hasPermission("companies", "create");
      allow update: if hasPermission("companies", "update");
      allow delete: if hasPermission("companies", "delete");
    }

    match /administrations/{administrationId} {
      allow read: if isSignedIn();
      allow create: if hasPermission("administrations", "create");
      allow update: if hasPermission("administrations", "update");
      allow delete: if hasPermission("administrations", "delete");
    }

    match /departments/{departmentId} {
      allow read: if isSignedIn();
      allow create: if hasPermission("departments", "create");
      allow update: if hasPermission("departments", "update");
      allow delete: if hasPermission("departments", "delete");
    }

    // complaints.reassign moves a complaint directly — no separate
    // approval step. Anyone who also holds complaints.update can write any
    // field regardless.
    function isReassignWrite() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return affected.hasOnly(["assignedTo", "updatedAt", "history"]);
    }

    // The current assignee can move a complaint's status even without
    // complaints.update — mirrors tickets' isTicketStatusOnlyWrite().
    function isComplaintStatusOnlyWrite() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return affected.hasOnly(["status", "updatedAt", "history"]);
    }

    // Without complaints.viewAll, a staff member only sees complaints
    // currently assigned to them. `list` queries are validated against the
    // query shape, not fetched-then-filtered — the client must query with a
    // matching where("assignedTo","==",uid) clause, or Firestore denies the
    // whole request rather than silently returning a subset.
    function canReadComplaint() {
      return hasPermission("complaints", "viewAll")
        || (hasPermission("complaints", "view") && resource.data.assignedTo == request.auth.uid);
    }

    match /complaints/{complaintId} {
      allow get: if canReadComplaint();
      allow list: if canReadComplaint();
      allow update: if hasPermission("complaints", "update")
        || (hasPermission("complaints", "reassign") && isReassignWrite())
        || (isSignedIn() && resource.data.assignedTo == request.auth.uid && isComplaintStatusOnlyWrite());
      allow delete: if hasPermission("complaints", "delete");
      allow create: if isSignedIn() && hasPermission("complaints", "create") && isSelfCreatedComplaint();
    }

    // Tickets — a separate, parallel system to Complaints for internal
    // requests an employee files for themselves. Filing one is open to any
    // signed-in employee (no tickets.create permission gate, by design);
    // "My Tickets" means either you filed it or you're the current
    // assignee, so read access covers both, not just assignedTo like
    // complaints. Status can be moved by anyone with tickets.update, or —
    // uniquely to tickets — by the current assignee even without that
    // permission, changing only the status/history fields.
    function isSelfCreatedTicket() {
      let d = request.resource.data;
      // Must match TICKET_ADMINISTRATION_ID in src/lib/tickets.ts exactly —
      // rules can't import that constant, so keep the two in sync by hand.
      return d.createdBy == request.auth.uid && d.administrationId == "leMoMH7aViBh7tSM0UtH";
    }

    function isTicketReassignWrite() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return affected.hasOnly(["departmentId", "assignedTo", "updatedAt", "history"]);
    }

    function isTicketStatusOnlyWrite() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return affected.hasOnly(["status", "updatedAt", "history"]);
    }

    function isTicketNotesOnlyWrite() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return affected.hasOnly(["notes", "updatedAt", "history"]);
    }

    function canReadTicket() {
      return hasPermission("tickets", "viewAll")
        || resource.data.assignedTo == request.auth.uid
        || resource.data.createdBy == request.auth.uid;
    }

    match /tickets/{ticketId} {
      allow get: if canReadTicket();
      allow list: if canReadTicket();
      allow update: if hasPermission("tickets", "update")
        || (hasPermission("tickets", "reassign") && isTicketReassignWrite())
        || (isSignedIn() && resource.data.assignedTo == request.auth.uid && isTicketStatusOnlyWrite())
        || (canReadTicket() && isTicketNotesOnlyWrite());
      allow delete: if hasPermission("tickets", "delete");
      allow create: if isSignedIn() && isSelfCreatedTicket();
    }

    // Sequential complaint IDs ("1", "2", "3", ...) — counters/complaints
    // holds the last-issued number, incremented in the same client
    // transaction that creates the complaint doc (see createComplaint() in
    // src/lib/complaints.ts). Scoped to complaints.create, and validated so
    // a write can only ever bump the value by exactly 1 (or set it to 1 on
    // first use) — never set it to an arbitrary number. counters/tickets
    // works the same way, just open to any signed-in employee to match
    // ticket creation itself.
    match /counters/{counterId} {
      allow read: if isSignedIn();
      allow create: if (
          (counterId == "complaints" && hasPermission("complaints", "create"))
          || (counterId == "tickets" && isSignedIn())
        )
        && request.resource.data.value == 1;
      allow update: if (
          (counterId == "complaints" && hasPermission("complaints", "create"))
          || (counterId == "tickets" && isSignedIn())
        )
        && request.resource.data.value == resource.data.value + 1;
    }

    // Public staff-account requests. Deliberately holds no password — an
    // admin reviews it and creates the real Firebase Auth account (with a
    // password of their choosing) via the Employees "New Employee" flow.
    //
    // Creation goes exclusively through /api/signup/create (Admin SDK,
    // bypasses these rules) rather than a direct client write, because
    // contactVerified must never be a client-supplied boolean — that route
    // independently confirms the contact was actually verified (an
    // emailVerificationCodes doc marked verified:true, or a real Firebase
    // Auth ID token proving a confirmed phone sign-in) before ever setting
    // it true. A direct client create here could otherwise forge
    // contactVerified: true for a contact nobody ever proved they control.
    match /signupRequests/{requestId} {
      allow create: if false;
      allow read, update, delete: if hasPermission("employees", "update");
    }

    // Roles. Reading the list only needs roles.view; every mutation goes
    // through /api/roles (Admin SDK) instead of a direct client write,
    // because editing or deleting a role must cascade — recomputing the
    // denormalized `permissions` of every employee who holds it — which
    // touches documents beyond the one write these rules would otherwise
    // be evaluating.
    match /roles/{roleId} {
      allow read: if hasPermission("roles", "view");
      allow write: if false;
    }

    // Complaint Types / Sources — admin-managed picklists offered on the New
    // Complaint form. Any signed-in staff member can read the list (needed
    // to fill out a complaint); only complaintTypes/complaintSources
    // permissions gate adding, renaming, or removing entries.
    match /complaintTypes/{typeId} {
      allow read: if isSignedIn();
      allow create: if hasPermission("complaintTypes", "create");
      allow update: if hasPermission("complaintTypes", "update");
      allow delete: if hasPermission("complaintTypes", "delete");
    }

    match /complaintSources/{sourceId} {
      allow read: if isSignedIn();
      allow create: if hasPermission("complaintSources", "create");
      allow update: if hasPermission("complaintSources", "update");
      allow delete: if hasPermission("complaintSources", "delete");
    }

    // Ticket Types / Sources — the same picklist pattern as Complaint
    // Types/Sources above, offered on the New Ticket form.
    match /ticketTypes/{typeId} {
      allow read: if isSignedIn();
      allow create: if hasPermission("ticketTypes", "create");
      allow update: if hasPermission("ticketTypes", "update");
      allow delete: if hasPermission("ticketTypes", "delete");
    }

    match /ticketSources/{sourceId} {
      allow read: if isSignedIn();
      allow create: if hasPermission("ticketSources", "create");
      allow update: if hasPermission("ticketSources", "update");
      allow delete: if hasPermission("ticketSources", "delete");
    }

    // Forgot-password rate-limit counters, written only by the Admin SDK
    // from /api/auth/reset-password (an unauthenticated route, by design —
    // no client, signed in or not, should ever touch this directly).
    match /passwordResetAttempts/{userId} {
      allow read, write: if false;
    }

    // Staff-signup email verification codes, written only by the Admin SDK
    // from /api/signup/send-email-code and /api/signup/verify-email-code
    // (both unauthenticated by design — no client should read or write a
    // code directly, since that would let anyone self-verify).
    match /emailVerificationCodes/{email} {
      allow read, write: if false;
    }
  }
}
