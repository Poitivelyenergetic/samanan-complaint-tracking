# Copy this file to .env.local and fill in your own Firebase project values.
# Never commit .env.local — it is already covered by .gitignore.

# ---- Client-side config ----------------------------------------------------
# Firebase Console > Project settings > General > "Your apps" > SDK setup and
# configuration (Config). These are safe to expose to the browser (NEXT_PUBLIC_*).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Server-side / Admin SDK config (used by scripts/seed.ts) -------------
# Firebase Console > Project settings > Service accounts > Generate new
# private key. Open the downloaded JSON file and copy the three fields below.
# Keep the surrounding quotes around FIREBASE_PRIVATE_KEY and leave the \n
# sequences as literal text — the app converts them to real newlines.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---- Resend (server-side, sends the signup verification email) ------------
# resend.com > API Keys. In production this is stored as a Firebase App
# Hosting secret instead (see apphosting.yaml) — set it there with:
#   firebase apphosting:secrets:set RESEND_API_KEY
RESEND_API_KEY=

# ---- Sentry (error monitoring) ---------------------------------------------
# Safe to expose to the browser — a DSN is a write-only ingest endpoint, not
# a secret. Get it from your Sentry project's Settings > Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=
